# isutools: 問題固有の設定。競技開始直後にここだけ書き換えて push する。
# 全コマンドで共通の KEY=VALUE 形式。空白を含む値はクォートする。
# 変数展開やコマンド置換は行わない。環境変数による指定が最優先。

# 競技サーバ（~/.ssh/config の Host 名）
HOSTS="s1 s2 s3"

# 競技用リポジトリ
GIT_REMOTE=git@github.com:ue-sho/isucon12-final.git

# アプリ（/home/isucon からの相対パス）と systemd サービス名
APP_DIR=webapp/node
APP_SERVICE=isuconquest.node.service
# デプロイ時のビルドコマンド（APP_DIR で実行。不要なら空）
BUILD_CMD=
# node / npm のあるディレクトリ（/home/isucon/local/*/bin 以外にある場合だけ指定）
NODE_BIN_DIR=

# DB の systemd サービス名（mysql / mariadb）
DB_SERVICE=mysql

# ログのパス
NGINX_LOG=/var/log/nginx/access.log
SLOW_LOG=/var/log/mysql/mysql-slow.log

# pprotein 本体を置くホスト（ベンチで使われないホスト）
PPROTEIN_HOST=s3

# ISUCON 提供の env ファイル（空なら APP_SERVICE の EnvironmentFile= から自動検出）
ENV_FILES=/home/isucon/env

# ツールのバージョン（固定）
ALP_VERSION=1.0.21
SLP_VERSION=0.2.1
PPROTEIN_VERSION=1.2.4

# これより大きいファイルはコミットしない（MB）
LARGE_FILE_MB=50
