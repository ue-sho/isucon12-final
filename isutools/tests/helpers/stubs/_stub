#!/usr/bin/env python3
"""Record fake service commands and inject failures without touching real services."""
import os
from pathlib import Path
import sys

command = Path(sys.argv[0]).name
args = sys.argv[1:]
base = Path(os.environ['FAKE_HOSTS']) / os.environ.get('FAKE_HOST', 'local')
base.mkdir(parents=True, exist_ok=True)
with (base / 'calls.log').open('a') as output:
    output.write(command + ' ' + ' '.join(args) + '\n')
if (base / ('fail-' + command)).exists():
    print(command + ': injected failure', file=sys.stderr)
    sys.exit(1)
if command == 'curl' and '@-' in args:
    (base / 'curl.stdin').write_text(sys.stdin.read())
if command == 'systemctl' and args and args[0] in ('is-enabled', 'is-active'):
    def listed(name):
        path = base / name
        return path.exists() and args[1] in path.read_text().splitlines()
    sys.exit(0 if listed('enabled') and not (args[0] == 'is-active' and listed('inactive')) else 3)
